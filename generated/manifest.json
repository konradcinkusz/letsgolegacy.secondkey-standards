      "category": "layering",
      "diagnostics": [
        "PORTCULLIS_P9_CONTROLLER_NO_DBCONTEXT"
      ],
      "principle": "P9",
      "hash": "sha256:e3a4a5eb6976417f"
    },
    {
      "id": "SK-ARCH-006",

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generated by secondkey-standards from catalog/pack.json. Do not edit.

    A configuration-only package: no assembly (IncludeBuildOutput=false), a development
    dependency (so it never flows into a consumer's runtime dependencies), and build/ props
    that load the global analyzer config. Pack it with:
      dotnet pack generated/nuget/SecondKey.Standards.csproj -o artifacts/packages
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>SecondKey.Standards</PackageId>
    <Version>0.1.0</Version>
    <Description>Analyzer configuration for the Second Key migration standards: sets the severity of every Portcullis and .NET SDK diagnostic that checks a standard, through a global analyzer config that the package&apos;s build props add to every build.</Description>
    <PackageTags>secondkey;standards;migration;analyzers;globalconfig;editorconfig</PackageTags>
    <PackageProjectUrl>https://github.com/konradcinkusz/letsgolegacy.secondkey-standards</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- The global config's source is a dotfile, which NuGet excludes unless told otherwise. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/SecondKey.Standards.props" Pack="true" PackagePath="build/SecondKey.Standards.props" />
    <None Include="../config/.globalconfig" Pack="true" PackagePath="build/SecondKey.Standards.globalconfig" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>

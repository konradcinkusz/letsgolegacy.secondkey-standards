      "category": "data-access",
      "diagnostics": [
        "PORTCULLIS_P4_ENSURE_CREATED_OUTSIDE_TEST"
      ],
      "principle": "P4",
      "hash": "sha256:9ddeedc63f38329d"
    },
    {
      "id": "SK-ARCH-002",
      "title": "Move EF6 seed data to a versioned seeding step, not HasData in the model",
      "severity": "warning",
      "category": "data-access",
      "diagnostics": [
        "PORTCULLIS_P4_SEED_DATA_IN_MODEL"
      ],
      "principle": "P4",
      "hash": "sha256:9dc2e46fbe6a8c8e"
    },
    {
      "id": "SK-ARCH-003",
      "title": "Move no credential from web.config into a committed file",
      "severity": "error",
      "category": "configuration",
      "diagnostics": [],
      "principle": "P5",
      "hash": "sha256:a9ba0fb49f53d572"
    },
    {
      "id": "SK-ARCH-004",
      "title": "Keep Program.cs a manifest; move Global.asax and App_Start wiring into extension methods",
      "severity": "suggestion",
      "category": "layering",
      "diagnostics": [],
      "principle": "P9",
      "hash": "sha256:f2fce0a345741dad"
    },
    {
      "id": "SK-ARCH-005",
      "title": "Introduce no DbContext into a controller; record the ones carried over",

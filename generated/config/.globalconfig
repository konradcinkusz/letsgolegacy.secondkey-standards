# Second Key migration standards 0.1.0: the severity of every diagnostic that checks a standard.
# Generated by secondkey-standards from standards/*.md. Do not edit: change the rule and
# regenerate.
#
# A global analyzer config: it applies to every file of every project that loads it. The
# SecondKey.Standards NuGet package loads it through build/SecondKey.Standards.props;
# without the package, copy it to a repository root as .globalconfig.
#
# global_level 0 places it above the .NET SDK's analysis-level defaults (negative levels)
# and below a repository's own .globalconfig (100 unless set); any .editorconfig entry
# overrides it. A consumer can always tune a severity locally.
is_global = true
global_level = 0

# SK-ARCH-001 Treat the existing schema as the contract; migrate it, never EnsureCreated it
dotnet_diagnostic.PORTCULLIS_P4_ENSURE_CREATED_OUTSIDE_TEST.severity = error

# SK-ARCH-002 Move EF6 seed data to a versioned seeding step, not HasData in the model
dotnet_diagnostic.PORTCULLIS_P4_SEED_DATA_IN_MODEL.severity = warning

# SK-ARCH-005 Introduce no DbContext into a controller; record the ones carried over
dotnet_diagnostic.PORTCULLIS_P9_CONTROLLER_NO_DBCONTEXT.severity = warning

# SK-ARCH-006 Add extension points as interfaces registered in DI, not new base classes
dotnet_diagnostic.PORTCULLIS_P10_CUSTOM_BASE_CLASS.severity = suggestion

# SK-ARCH-007 Wire the solution's shared service defaults into the new host; invent none mid-migration
dotnet_diagnostic.PORTCULLIS_P15_MISSING_SERVICE_DEFAULTS.severity = suggestion

# SK-MIG-001 Replace System.Web hosting types with ASP.NET Core
dotnet_diagnostic.PORTCULLIS_MIG_SYSTEM_WEB.severity = error

# SK-MIG-002 Pass request data explicitly instead of reading HttpContext.Current
dotnet_diagnostic.PORTCULLIS_MIG_HTTPCONTEXT_CURRENT.severity = error

# SK-MIG-003 Keep asynchronous code asynchronous all the way; never block on a task
dotnet_diagnostic.PORTCULLIS_MIG_SYNC_OVER_ASYNC.severity = error

# SK-MIG-004 Read settings through IOptions<T> or IConfiguration, never ConfigurationManager
dotnet_diagnostic.PORTCULLIS_MIG_CONFIGURATION_MANAGER.severity = error

# SK-MIG-005 State the StringComparison of every culture-sensitive string comparison and sort
dotnet_diagnostic.CA1310.severity = warning

# SK-MIG-006 Name the culture for formatting, parsing and casing, and keep the legacy culture source
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1311.severity = warning

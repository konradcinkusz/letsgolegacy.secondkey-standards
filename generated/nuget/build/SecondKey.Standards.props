<Project>

  <!--
    Generated by secondkey-standards. Do not edit.

    Adds the Second Key standards' global analyzer config to this project's compilation.
    Set SecondKeyStandardsGlobalConfig to false to switch it off; override a single
    severity in the repository's .editorconfig, which always takes precedence.
  -->
  <PropertyGroup>
    <SecondKeyStandardsVersion>0.1.0</SecondKeyStandardsVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(SecondKeyStandardsGlobalConfig)' != 'false'">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)SecondKey.Standards.globalconfig" />
  </ItemGroup>

</Project>

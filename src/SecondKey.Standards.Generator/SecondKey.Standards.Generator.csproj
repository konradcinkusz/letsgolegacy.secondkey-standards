<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The standards generator. One tool, three jobs, all reading the same sources:
      validate      check every rule in standards/ against its contract
      generate      compile the rules into skills, analyzer configuration and a NuGet package
      drift-check   tell a consuming repository whether its pinned standards version is current

    A .NET console tool rather than a script, because the people who run it already run .NET
    (product principle 3): it installs with `dotnet tool install` and needs nothing else.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecondKey.Standards.Generator</RootNamespace>
    <AssemblyName>SecondKey.Standards.Generator</AssemblyName>
    <Version>0.1.0</Version>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>secondkey-standards</ToolCommandName>
    <PackageId>SecondKey.Standards.Generator</PackageId>
    <Description>Validates the Second Key migration standards and compiles them into agent skills, analyzer configuration and a drift check.</Description>
    <PackageTags>secondkey;standards;migration;agent-skills;editorconfig;globalconfig</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecondKey.Standards.Generator.Tests" />
  </ItemGroup>

</Project>
